    }
    duplicateSelectedEntity() {
        if (this.selectedIndex === null || !this.stage.entities) return;
        this.saveHistory();
        const original = this.stage.entities[this.selectedIndex];
        const clone = JSON.parse(JSON.stringify(original));
        clone.position.x += 1;
        clone.position.y += 1;

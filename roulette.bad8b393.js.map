        const tolPx = 10;
        const tolWorld = tolPx / this.zoom;
        // 1. Polyline: 각 정점(Vertex) 핸들 검사
        if (shape.type === 'polyline') {
            const poly = shape;
            for(let i = 0; i < poly.points.length; i++){
                const p = poly.points[i];
                const ptW = {
                    x: entity.position.x + p[0],
                    y: entity.position.y + p[1]
